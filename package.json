{
  "name": "dna",
  "displayName": "DNA",
  "description": "DNA's visual explainer in the Markdown preview: explainers that draw themselves, chapter by chapter, from a visual-explainer or visual-explainer-mermaid code block — and the syntax of both lit in the editor.",
  "version": "0.4.0",
  "publisher": "ruinosus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruinosus/vscode-dna.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Education",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "mermaid",
    "diagram",
    "hand-drawn",
    "explainer",
    "explainer",
    "dna"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/mount.global.js"
    ],
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "languages": [
      {
        "id": "visual-explainer",
        "aliases": [
          "Visual Explainer",
          "visual-explainer",
          "chalk-talk"
        ],
        "extensions": [
          ".chalk"
        ],
        "configuration": "./visual-explainer.language-configuration.json"
      },
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./mermaid.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "visual-explainer",
        "scopeName": "source.visual-explainer",
        "path": "./syntaxes/visual-explainer.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.inline.json": "json"
        }
      },
      {
        "language": "mermaid",
        "scopeName": "source.visual-explainer-mermaid",
        "path": "./syntaxes/visual-explainer-mermaid.tmLanguage.json"
      },
      {
        "scopeName": "markdown.visual-explainer.codeblock",
        "path": "./syntaxes/markdown-visual-explainer.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.visual-explainer": "visual-explainer"
        }
      },
      {
        "scopeName": "markdown.visual-explainer-mermaid.codeblock",
        "path": "./syntaxes/markdown-visual-explainer-mermaid.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.mermaid": "mermaid"
        }
      }
    ]
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "package": "npm run build && npm run check && npx -y @vscode/vsce@3 package --no-dependencies",
    "check": "node check-grammar.mjs"
  },
  "dependencies": {
    "@ruinosus/visual-explainer": "^0.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.80.0",
    "esbuild": "0.24.0",
    "typescript": "5.6.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
